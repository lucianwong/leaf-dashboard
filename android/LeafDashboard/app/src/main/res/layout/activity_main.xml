<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏 Frame 显示 + 首启动设置面板。黑色背景契合 E-Ink,避免点亮瞬间的白闪 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/frame_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:id="@+id/setup_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="48dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@android:color/black">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <!-- 高对比(E-Ink 可读):纯白底纯黑字,避免默认深色控件在墨水屏上发灰看不清 -->
        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="@string/setup_hint"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:textSize="22sp"
            android:padding="16dp"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:text="@string/setup_save"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_skip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:text="@string/setup_skip"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 右下角浮动刷新按钮:64dp 触摸区,白半透明圆底 + 黑描边,不紧贴边缘 -->
    <ImageButton
        android:id="@+id/btn_refresh"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_refresh_button"
        android:contentDescription="@string/refresh_cd"
        android:scaleType="center"
        android:src="@android:drawable/ic_menu_rotate" />
</FrameLayout>
